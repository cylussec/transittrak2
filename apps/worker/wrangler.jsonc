/**
 * For more details on how to configure Wrangler, refer to:
 * https://developers.cloudflare.com/workers/wrangler/configuration/
 */
{
	"$schema": "../../node_modules/wrangler/config-schema.json",
	"name": "transittrack-worker",
	"main": "src/index.ts",
	"compatibility_date": "2025-09-06",
	"compatibility_flags": [
		"global_fetch_strictly_public"
	],
	"assets": {
		// The path to the directory containing the `index.html` file to be served at `/`
		"directory": "./site"
	},
	"triggers": {
		"crons": [
			"* * * * *",
			"0 * * * *"
		] // Run every minute for realtime, and every hour for D1 hot-cache cleanup
	},
	"observability": {
		"enabled": true
	},
	"env": {
		"staging": {
			"name": "transittrack-worker-staging",
			"triggers": {
				"crons": [
					"* * * * *",
					"0 * * * *"
				]
			},
			"vars": {
				"ENVIRONMENT": "staging"
			},
			"durable_objects": {
				"bindings": [
					{
						"name": "INGEST_COORDINATOR",
						"class_name": "IngestCoordinator"
					},
					{
						"name": "GTFS_STATIC_COORDINATOR",
						"class_name": "GtfsStaticCoordinator"
					}
				]
			},
			"migrations": [
				{
					"tag": "v1",
					"new_sqlite_classes": [
						"IngestCoordinator"
					]
				},
				{
					"tag": "v2",
					"new_sqlite_classes": [
						"GtfsStaticCoordinator"
					]
				}
			],
			"d1_databases": [
				{
					"binding": "DB",
					"database_name": "transittrack-staging",
					"database_id": "79dad050-34f7-4e2e-aec9-d65e07d6972c",
					"migrations_dir": "migrations",
					"migrations_table": "d1_migrations"
				}
			],
			"r2_buckets": [
				{
					"binding": "ARCHIVE_BUCKET",
					"bucket_name": "transittrack-archive-staging"
				}
			],
			"pipelines": [
				{
					"pipeline": "dce1076ace7842c093f584a2593e6f5d",
					"binding": "VP_PIPELINE"
				},
				{
					"pipeline": "0f37aff6d52d4f2880dbeb0c6f9caeb2",
					"binding": "TU_PIPELINE"
				}
			],
			"queues": {
				"producers": [
					{
						"binding": "PARSE_QUEUE",
						"queue": "transittrack-parse-queue-staging"
					}
				],
				"consumers": [
					{
						"queue": "transittrack-parse-queue-staging",
						"max_batch_size": 10,
						"max_batch_timeout": 5
					}
				]
			}
		}
	},
	"vars": {
		"ENVIRONMENT": "production"
	},
	"r2_buckets": [
		{
			"binding": "ARCHIVE_BUCKET",
			"bucket_name": "transittrack-archive"
		}
	],
	"durable_objects": {
		"bindings": [
			{
				"name": "INGEST_COORDINATOR",
				"class_name": "IngestCoordinator"
			},
			{
				"name": "GTFS_STATIC_COORDINATOR",
				"class_name": "GtfsStaticCoordinator"
			}
		]
	},
	"migrations": [
		{
			"tag": "v1",
			"new_sqlite_classes": [
				"IngestCoordinator"
			]
		},
		{
			"tag": "v2",
			"new_sqlite_classes": [
				"GtfsStaticCoordinator"
			]
		}
	],
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "transittrack",
			"database_id": "6699a326-360c-482f-9aec-f8dfc30093c8",
			"migrations_dir": "migrations",
			"migrations_table": "d1_migrations"
		}
	],
	"pipelines": [
		{
			"pipeline": "dce1076ace7842c093f584a2593e6f5d",
			"binding": "VP_PIPELINE"
		},
		{
			"pipeline": "0f37aff6d52d4f2880dbeb0c6f9caeb2",
			"binding": "TU_PIPELINE"
		}
	],
	"queues": {
		"producers": [
			{
				"binding": "PARSE_QUEUE",
				"queue": "transittrack-parse-queue"
			}
		],
		"consumers": [
			{
				"queue": "transittrack-parse-queue",
				"max_batch_size": 10,
				"max_batch_timeout": 5
			}
		]
	}
	/**
	 * Smart Placement
	 * https://developers.cloudflare.com/workers/configuration/smart-placement/#smart-placement
	 */
	// "placement": {  "mode": "smart" }
	/**
	 * Bindings
	 * Bindings allow your Worker to interact with resources on the Cloudflare Developer Platform, including
	 * databases, object storage, AI inference, real-time communication and more.
	 * https://developers.cloudflare.com/workers/runtime-apis/bindings/
	 */
	/**
	 * Environment Variables
	 * https://developers.cloudflare.com/workers/wrangler/configuration/#environment-variables
	 * Note: Use secrets to store sensitive data.
	 * https://developers.cloudflare.com/workers/configuration/secrets/
	 */
	// "vars": {  "MY_VARIABLE": "production_value" }
	/**
	 * Service Bindings (communicate between multiple Workers)
	 * https://developers.cloudflare.com/workers/wrangler/configuration/#service-bindings
	 */
	// "services": [  {   "binding": "MY_SERVICE",   "service": "my-service"  } ]
}